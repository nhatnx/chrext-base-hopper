{
  "manifest_version": 3,
  "name": "BaseHopper",
  "version": "1.0.0",
  "description": "Quickly switch between multiple Supabase accounts",
  "permissions": ["storage", "cookies", "tabs", "scripting"],
  "host_permissions": ["https://supabase.com/*", "https://*.supabase.com/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://supabase.com/*", "https://*.supabase.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
